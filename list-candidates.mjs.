import {db,admin,reply,options} from './utils.mjs';
export default async req=>{const opt=options(req);if(opt)return opt;if(req.method!=='POST')return reply(405,{error:'Método no permitido.'});try{await admin(req);const {data,error}=await db().from('candidatos').select('id,folio,full_name,email,phone,status,observations,created_at').order('created_at',{ascending:false}).limit(500);if(error)throw error;return reply(200,{candidates:(data||[]).map(c=>({id:c.id,folio:c.folio,nombre_completo:c.full_name,correo:c.email,telefono:c.phone,estatus:c.status,observaciones:c.observations,creado_en:c.created_at}))})}catch(e){return reply(400,{error:e.message||'No se pudo cargar la lista.'})}};
